// Prisma schema — voetbal training planner
// Docs: https://pris.ly/d/prisma-schema
// NOTE: SQLite does not support Prisma `enum`s. String fields below carry a
// fixed set of allowed values, enforced in the app layer via Zod (see lib/enums.ts).

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "sqlite"
}

/// A single training form (warm-up, exercise, or match form).
model Drill {
  id              Int      @id @default(autoincrement())
  title           String
  type            String // WARMUP | EXERCISE | MATCHFORM
  theme           String // ATTACK | DEFEND | TRANSITION | NEUTRAL
  subTheme        String? // KNVB leerdoel within the theme (Dutch label; see lib/enums SUB_THEMES)
  ageMin          Int      @default(15)
  ageMax          Int      @default(15)
  fieldType       String // CIRCUIT | QUARTER | HALF | FULL | INDOOR
  footprintX      Float // required width in metres
  footprintY      Float // required length in metres
  minPlayers      Int
  idealPlayers    Int
  maxPlayers      Int
  durationMin     Int
  // How many balls the drill needs: FIXED (use placed ball markers) | PER_PLAYER
  // (one per player, e.g. everyone dribbles) | PER_PAIR (one per two players).
  ballScaling     String   @default("FIXED")
  description     String
  // Structured, coach-readable instructions (all optional/back-compatible):
  setup           String? // Opstelling: how to lay the field out
  steps           String? // Stappen: JSON string array of ordered instructions
  rules           String? // Spelregels
  coachingPoints  String?
  progressions    String?
  simplifications String?
  videoUrl        String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  aids     DrillAid[]
  actions  DrillAction[]
  stations BlockStation[]
}

/// An ordered movement within a drill (pass/run/dribble/shot). Feeds the diagram
/// arrows now and the play-button animation later. Coordinates are in metres
/// relative to the footprint origin (0,0 = top-left), like DrillAid.
model DrillAction {
  id      Int    @id @default(autoincrement())
  drill   Drill  @relation(fields: [drillId], references: [id], onDelete: Cascade)
  drillId Int
  order   Int // play/animation sequence
  kind    String // PASS | RUN | DRIBBLE | SHOT | CARRY
  fromX   Float
  fromY   Float
  toX     Float
  toY     Float
  label   String?

  @@index([drillId])
}

/// A placed aid (goal/cone/marker) within a drill's footprint. Coordinates are in
/// metres relative to the footprint origin (0,0 = top-left), so diagrams can be drawn.
model DrillAid {
  id       Int     @id @default(autoincrement())
  drill    Drill   @relation(fields: [drillId], references: [id], onDelete: Cascade)
  drillId  Int
  type     String // BIG_GOAL | SMALL_GOAL | DISC_CONE | CONE | PLAYER | BALL | MARKER
  x        Float
  y        Float
  rotation Float   @default(0)
  label    String?

  @@index([drillId])
}

/// A saved (generated then refined) training session.
model Session {
  id          Int      @id @default(autoincrement())
  date        DateTime @default(now())
  label       String?
  ageCategory String // e.g. "U15"
  theme       String
  durationMin Int
  players     Int
  spaceType   String // HALF | QUARTER | FULL | INDOOR
  notes       String?
  createdAt   DateTime @default(now())

  blocks SessionBlock[]
}

/// A time-block within a session: whole-group or a split (two parallel stations).
model SessionBlock {
  id          Int     @id @default(autoincrement())
  session     Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sessionId   Int
  order       Int
  kind        String // WHOLE | SPLIT
  durationMin Int
  label       String?

  stations BlockStation[]

  @@index([sessionId])
}

/// One drill running in a block, for a given group, on a given side of the pitch.
model BlockStation {
  id                 Int          @id @default(autoincrement())
  block              SessionBlock @relation(fields: [blockId], references: [id], onDelete: Cascade)
  blockId            Int
  drill              Drill        @relation(fields: [drillId], references: [id])
  drillId            Int
  group              String // ALL | A | B
  side               String // FULL | LEFT | RIGHT
  order              Int          @default(0)
  placementOverrides String? // JSON: coach's nudged aid positions

  @@index([blockId])
  @@index([drillId])
}

/// A player in the (single) team's roster.
model Player {
  id                Int       @id @default(autoincrement())
  firstName         String
  lastName          String?
  shirtNumber       Int?
  preferredPosition String // POSITION_CODES (see lib/enums.ts)
  secondaryPosition String? // optional POSITION_CODES
  birthDate         DateTime?
  active            Boolean   @default(true)
  notes             String? // quick free-text remark
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  comments              PlayerComment[]
  attendance            Attendance[]
  lineupEntries         LineupEntry[]
  lineupTemplateEntries LineupTemplateEntry[]
}

/// A dated remark about a player (running log).
model PlayerComment {
  id       Int      @id @default(autoincrement())
  player   Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  playerId Int
  date     DateTime @default(now())
  text     String

  @@index([playerId])
}

/// A standalone training date, against which attendance is recorded.
model TrainingEvent {
  id        Int      @id @default(autoincrement())
  date      DateTime
  label     String?
  createdAt DateTime @default(now())

  attendance Attendance[]
}

/// One attendance row per (training event, player): present + who cleaned up.
model Attendance {
  id         Int           @id @default(autoincrement())
  event      TrainingEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  eventId    Int
  player     Player        @relation(fields: [playerId], references: [id], onDelete: Cascade)
  playerId   Int
  present    Boolean       @default(true)
  didCleanup Boolean       @default(false)

  @@unique([eventId, playerId])
  @@index([eventId])
  @@index([playerId])
}

/// A Saturday match (opponent + date) that a lineup is built for.
model Match {
  id        Int      @id @default(autoincrement())
  date      DateTime
  opponent  String
  homeAway  String   @default("THUIS") // THUIS | UIT
  formation String   @default("4-3-3") // FORMATION key (see lib/formations.ts)
  location  String?
  result    String? // free text, e.g. "3-1"
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lineup LineupEntry[]
}

/// One row per player considered for a match: availability role + pitch placement.
model LineupEntry {
  id       Int    @id @default(autoincrement())
  match    Match  @relation(fields: [matchId], references: [id], onDelete: Cascade)
  matchId  Int
  player   Player @relation(fields: [playerId], references: [id], onDelete: Cascade)
  playerId Int
  role     String @default("BENCH") // STARTER | BENCH | UNAVAILABLE
  x        Float? // pitch position in metres (starters placed by drag)
  y        Float?
  slot     Int? // formation slot index the player occupies

  @@unique([matchId, playerId])
  @@index([matchId])
  @@index([playerId])
}

/// Singleton (id = 1): the coach's default/first-choice lineup, used to pre-fill a
/// new match's builder. Set by "save as default" on any built lineup.
model LineupTemplate {
  id        Int      @id @default(1)
  formation String   @default("4-3-3")
  updatedAt DateTime @updatedAt

  entries LineupTemplateEntry[]
}

/// One placed player in the default lineup (metres, like LineupEntry).
model LineupTemplateEntry {
  id         Int            @id @default(autoincrement())
  template   LineupTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  templateId Int
  player     Player         @relation(fields: [playerId], references: [id], onDelete: Cascade)
  playerId   Int
  role       String         @default("STARTER")
  x          Float?
  y          Float?
  slot       Int?

  @@unique([templateId, playerId])
  @@index([templateId])
  @@index([playerId])
}

/// Singleton (id = 1): the coach's materials inventory and default pitch size.
model Settings {
  id         Int      @id @default(1)
  bigGoals   Int      @default(2)
  smallGoals Int      @default(4)
  discCones  Int      @default(40)
  cones      Int      @default(20)
  pinnies    Int      @default(16)
  balls      Int      @default(16)
  pitchX     Float    @default(50) // available width in metres (half-pitch default)
  pitchY     Float    @default(35) // available length in metres
  updatedAt  DateTime @updatedAt
}
